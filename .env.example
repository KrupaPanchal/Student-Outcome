# Neon PostgreSQL Connection URL
DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-xxxx.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production

# MongoDB Connection URI (Optional fallback)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/student_outcomes?retryWrites=true&w=majority

# Server Port
PORT=3000
